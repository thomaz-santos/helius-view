{
  "name": "helius-view",
  "version": "0.0.0",
  "description": "Visualização 2D e 3D de codebases TS/JS: dependências, chamadas e entrada/saída de funções",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thomaz-santos/helius-view.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup && vite build",
    "dev": "tsup --watch --onSuccess \"node dist/cli.js --no-open\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "3d-force-graph": "^1.80.0",
    "force-graph": "^1.51.4",
    "husky": "^9.1.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "chokidar": "^5.0.0",
    "hono": "^4.13.8",
    "ignore": "^7.0.9",
    "ts-morph": "^28.0.0"
  },
  "bin": {
    "helius": "dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
